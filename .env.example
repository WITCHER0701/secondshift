[TEMPLATE]
# ── SecondShift configuration ────────────────────────────────────────
# Copy this file to .env and fill in what you use. Everything is optional:
# with an empty .env the site runs fully in local-only mode.

# ── Cloud sync (pick ONE provider — see CLOUD-SETUP.md) ──────────────
# GitHub Gist (recommended): token with ONLY the "gist" scope
CLOUD_GIST_TOKEN=
# printed on first push — copy it back here so every push updates the same store
CLOUD_GIST_ID=

# OR Firebase Realtime Database (Spark free plan)
FIREBASE_DB_URL=
FIREBASE_DB_SECRET=

# ── Telegram monitor (FREE ops watchdog — see TELEGRAM-SETUP.md) ──────
# Token from @BotFather, chat id from your own account — both free, no card
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Server ───────────────────────────────────────────────────────────
PORT=4000
ADMIN_PASSWORD=lab-admin-2026
SESSION_SECRET=change-me-in-production

# ── The Voice (per-client branding) ──────────────────────────────────
VOICE_BUSINESS_NAME=Demo Business
VOICE_BUSINESS_TYPE=auto repair shop

# ── First Response (per-client branding) ─────────────────────────────
FR_BUSINESS_NAME=Summit Roofing
FR_BUSINESS_TYPE=home services
FR_OWNER_NAME=the owner

# ── The Voice × Vapi (optional pro upgrade — see VOICE-VAPI.md) ──────
# Public key from dashboard.vapi.ai (safe to expose in the browser)
VAPI_PUBLIC_KEY=
# Assistant ID created in the Vapi dashboard
VAPI_ASSISTANT_ID=
# Optional shared secret: set the same value in Vapi custom-LLM auth
VAPI_SERVER_SECRET=

# ── The Voice × Dograh (free self-hosted tester) ─────────────────────
# Embed token from Dograh → agent settings → Add to Website → Configure Widget
DOGRAH_EMBED_TOKEN=
# Public tunnel URLs of the local Docker stack (they change whenever the
# Docker stack restarts — grab fresh ones with:
#   docker logs cloudflared-tunnel | grep trycloudflare   → DOGRAH_API_URL
#   docker logs dograh-ui-tunnel    | grep trycloudflare  → DOGRAH_UI_URL)
DOGRAH_UI_URL=
DOGRAH_API_URL=
